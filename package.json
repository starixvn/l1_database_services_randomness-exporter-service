{
    "name": "randomness-exporter-service",
    "version": "1.0.0",
    "description": "",
    "main": "lib/app.js",
    "scripts": {
        "yarn": "rimraf node_modules && yarn install",
        "pnpm": "rimraf node_modules && pnpm install",
        "test:single": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest",
        "test": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest --testPathPattern=tests/unit-tests/",
        "test-coverage": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest --collect-coverage --testPathPattern=tests/unit-tests/",
        "integration-test": "NODE_OPTIONS=\"--experimental-vm-modules --es-module-specifier-resolution=node --no-warnings\" jest --config ./jest.integration-test.config.ts --testPathPattern=tests/integration-tests/",
        "dev": "ts-node-esm ./src/app.ts",
        "dev:hc": "ts-node-esm ./src/healthcheck.ts",
        "build": "rimraf lib && tsc",
        "reg": "npm set registry http://npm.lumigame.com",
        "run:container": "node --es-module-specifier-resolution=node app.js",
        "run:healthcheck": "node --es-module-specifier-resolution=node healthcheck.js"
    },
    "jestSonar": {
        "reportPath": "reports",
        "reportFile": "test-reporter.xml",
        "indent": 4
    },
    "author": "",
    "license": "ISC",
    "type": "module",
    "dependencies": {
        "@ldb/scheduler": "^1.0.1",
        "@ldb/types": "^1.0.3",
        "@ldb/utils": "^0.1.2",
        "@sc-logger/sentry": "^1.0.11",
        "@sc-logger/skynex": "^1.0.8",
        "@sc-logger/terminal": "^1.0.4",
        "awilix": "^8.0.1",
        "bson": "^5.4.0",
        "mongodb": "^5.7.0"
    },
    "devDependencies": {
        "@commitlint/cli": "^17.6.7",
        "@commitlint/config-conventional": "^17.6.7",
        "@jest/globals": "^29.6.2",
        "@types/jest": "^29.5.3",
        "@types/node": "^18.17.1",
        "@typescript-eslint/eslint-plugin": "^5.62.0",
        "@typescript-eslint/parser": "^5.62.0",
        "eslint": "^8.45.0",
        "eslint-config-google": "^0.14.0",
        "eslint-config-prettier": "^8.8.0",
        "eslint-plugin-security": "^1.7.1",
        "jest": "^29.6.1",
        "jest-extended": "^3.2.4",
        "jest-html-reporters": "^3.1.4",
        "jest-junit": "^15.0.0",
        "jest-sonar-reporter": "^2.0.0",
        "nodemon": "^2.0.22",
        "ts-jest": "^29.1.1",
        "ts-node": "^10.9.1",
        "typescript": "^5.1.6"
    },
    "husky": {
        "hooks": {
            "commit-msg": "commitlint -E HUSKY_GIT_PARAMS"
        }
    }
}
